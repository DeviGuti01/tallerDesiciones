Algoritmo AndroidoIos
	
	Definir opcion1 Como Caracter
	Escribir "Digita tu letra: "
	Leer opcion1
	Si opcion1 == "a" O opcion1 == "A" Entonces
		Escribir "Android"
	Sino 
		Si opcion1 == "i" O opcion1 == "I" Entonces
			Escribir "Ios"
		SiNo
			Escribir "Opción invalida"
		FinSi
	FinSi
FinAlgoritmo
